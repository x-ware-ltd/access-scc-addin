Private Function fxDevNames() As String
  Dim s As String
  s = s & "0x08002400400001004c414e494552204d502043323530302f4c44343235632052 ," & vbCrLf
  s = s & "0x504353004c414e494552204d502043323530302f4c4434323563205250435300 ," & vbCrLf
  s = s & "0x49505f3139322e3136382e312e343900000000000000000000000000" & vbCrLf
  fxDevNames = s
End Function

